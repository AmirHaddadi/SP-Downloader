# ─────────────────────────────────────────────────────────────
# SP Downloader — environment configuration
# Copy this file to `.env` and adjust. Every value is optional.
# ─────────────────────────────────────────────────────────────

# HTTP port the web UI + API listen on.
PORT=4000

# MongoDB connection string. LEAVE EMPTY to run fully in-memory
# (download history then lives only for the current process).
# Example: mongodb://localhost:27017
MONGODB_URI=

# Database + collection names used for the download history.
MONGODB_DB_NAME=sp_downloader
MONGODB_DOWNLOADS_COLLECTION=download_history
